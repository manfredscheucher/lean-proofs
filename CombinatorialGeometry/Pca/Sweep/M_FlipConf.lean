# Package M, helpers: the flipped sweep configuration

The axioms of `SConf` for the flipped map `(σ, α' = ρ α ρ, curve, S)` of `Pca/Sweep/M_Flip.lean`
(`m_flip_isSConf`), the side function after the flip (`mSide'`, `m_flip_isSide`), and, for the
empty triangle above the finite edge of a sweep dart `d` (`t = α d`), the flipped sweep
configuration `mFlip` with the ∞-arc mapped by `ρ`.
-/
import Pca.Sweep.M_Flip

open Equiv Finset

namespace Pca.Sweep

universe u

variable {D : Type u} [Fintype D] [DecidableEq D] {n : ℕ}

namespace SConf

variable {Γ : SConf n D} {t : D} (hT : Γ.MTri t)

/-! ## Connectivity -/

/-- The equivalence relation generated by `σ` and `α'`. -/
abbrev MR := Relation.EqvGen (StepRel Γ.σ (mα hT))

theorem m_R_σ (y : D) : MR hT y (Γ.σ y) := .rel _ _ (Or.inl rfl)

theorem m_R_α' (y : D) : MR hT y (mα hT y) := .rel _ _ (Or.inr rfl)

theorem m_R_cross {a b : D} (h : Γ.crossingOf a = Γ.crossingOf b) : MR hT a b := by
  have h0 := (Γ.m_crossingOf_eq_iff).1 h
  simp only [List.mem_cons, List.not_mem_nil, or_false] at h0
  have h1 := m_R_σ hT a
  have h2 := h1.trans _ _ _ (m_R_σ hT _)
  have h3 := h2.trans _ _ _ (m_R_σ hT _)
  rcases h0 with rfl | rfl | rfl | rfl
  · exact .refl _
  · exact h1
  · exact h2
  · exact h3

section Sides

variable {b : D} (hb : Γ.cellOf b = Γ.cellOf t)
include hb

theorem mα_of_mem : mα hT b = Γ.α (Γ.straight b) := by
  rw [mα_apply, mρ_of_mem hT hb, mρ_of_not_corner hT (m_not_corner_end_straight hT hb)]

theorem mα_α_of_mem : mα hT (Γ.α b) = Γ.α (Γ.σ (Γ.σ b)) := by
  rw [mα_apply, mρ_α_of_mem hT hb, mρ_of_not_corner hT (m_not_corner_end_σσ hT hb)]

theorem mα_straight_of_mem : mα hT (Γ.straight b) = Γ.σ (Γ.σ b) := by
  rw [mα_apply, mρ_straight_of_mem hT hb, mρ_α_of_mem hT hb]

theorem mα_σσ_of_mem : mα hT (Γ.σ (Γ.σ b)) = Γ.straight b := by
  rw [mα_apply, mρ_σσ_of_mem hT hb, m_α_α, mρ_of_mem hT hb]

theorem mα_end_straight : mα hT (Γ.α (Γ.straight b)) = b := by
  rw [mα_apply, mρ_of_not_corner hT (m_not_corner_end_straight hT hb), m_α_α,
    mρ_straight_of_mem hT hb]

theorem mα_end_σσ : mα hT (Γ.α (Γ.σ (Γ.σ b))) = Γ.α b := by
  rw [mα_apply, mρ_of_not_corner hT (m_not_corner_end_σσ hT hb), m_α_α, mρ_σσ_of_mem hT hb]

theorem m_R_side : MR hT b (Γ.α b) := by
  refine (m_R_cross hT (Γ.m_crossingOf_σσ b).symm).trans _ _ _ ?_
  refine (m_R_α' hT _).trans _ _ _ ?_
  rw [mα_σσ_of_mem hT hb]
  exact m_R_cross hT (Γ.m_crossingOf_straight b)

theorem m_R_straight : MR hT (Γ.straight b) (Γ.α (Γ.straight b)) := by
  have h1 : MR hT (Γ.straight b) (Γ.σ (Γ.σ b)) := by
    have := m_R_α' hT (Γ.σ (Γ.σ b))
    rw [mα_σσ_of_mem hT hb] at this
    exact this.symm
  refine h1.trans _ _ _ ((m_R_cross hT (Γ.m_crossingOf_σσ b)).trans _ _ _ ?_)
  have := m_R_α' hT b
  rwa [mα_of_mem hT hb] at this

theorem m_R_σσ : MR hT (Γ.σ (Γ.σ b)) (Γ.α (Γ.σ (Γ.σ b))) := by
  have h1 := m_R_α' hT (Γ.σ (Γ.σ b))
  rw [mα_σσ_of_mem hT hb] at h1
  refine h1.trans _ _ _ ((m_R_cross hT (Γ.m_crossingOf_straight b)).trans _ _ _ ?_)
  have := m_R_α' hT (Γ.α b)
  rwa [mα_α_of_mem hT hb] at this

end Sides

/-- The ends of every old segment stay connected after the flip. -/
theorem m_R_α (y : D) : MR hT y (Γ.α y) := by
  rcases m_dart_cases hT y with ⟨hy, hα⟩ | ⟨b, hb, h | h⟩ | ⟨b, hb, h | h | h | h⟩
  · have : mα hT y = Γ.α y := by
      rw [mα_apply, mρ_of_not_corner hT hy, mρ_of_not_corner hT hα]
    rw [← this]; exact m_R_α' hT y
  all_goals subst y
  · rw [m_α_α]; exact (m_R_straight hT hb).symm
  · rw [m_α_α]; exact (m_R_σσ hT hb).symm
  · exact m_R_side hT hb
  · rw [m_α_α]; exact (m_R_side hT hb).symm
  · exact m_R_straight hT hb
  · exact m_R_σσ hT hb

theorem m_flip_connected (a e : D) : MR hT a e := by
  induction Γ.isSConf.connected a e with
  | rel x y h =>
    rcases h with rfl | rfl
    · exact m_R_σ hT x
    · exact m_R_α hT x
  | refl x => exact .refl _
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2

/-! ## The axioms -/

theorem m_flip_isSConf : IsSConf n Γ.σ (mα hT) Γ.curve Γ.S where
  card_crossing := Γ.isSConf.card_crossing
  α_ne y h := by
    rw [mα_apply] at h
    have := congrArg (mρ hT) h
    rw [mρ_mρ] at this
    exact Γ.m_α_ne _ this
  α_α y := by rw [mα_apply, mα_apply, mρ_mρ, m_α_α, mρ_mρ]
  curve_α y := by rw [mα_apply, m_curve_ρ, m_curve_α, m_curve_ρ]
  curve_σ := Γ.isSConf.curve_σ
  curve_σσ := Γ.isSConf.curve_σσ
  straight y z h := by
    have hm : ∀ {a c : D}, Γ.straight.SameCycle (mρ hT a) (mρ hT c) →
        (straightPerm Γ.σ (mα hT)).SameCycle a c := by
      intro a c hac
      have := sameCycle_map (f' := straightPerm Γ.σ (mα hT)) (mρ hT) (fun w => by
        have e : straightPerm Γ.σ (mα hT) (mρ hT w) = mρ hT (Γ.straight w) := by
          rw [m_flip_straightPerm, mρ_mρ]
        rw [← e]; exact sameCycle_self_apply _ _) hac
      rwa [mρ_mρ, mρ_mρ] at this
    have hc : Γ.curve (mρ hT y) = Γ.curve (mρ hT z) := by
      rw [m_curve_ρ, m_curve_ρ, h]
    rcases Γ.isSConf.straight _ _ hc with h1 | h1
    · exact Or.inl (hm h1)
    · rw [← mρ_σσ] at h1
      exact Or.inr (hm h1)
  two_int := Γ.isSConf.two_int
  connected := m_flip_connected hT
  euler hne := by
    rw [← Fintype.card_congr (mSegEquiv hT), ← Fintype.card_congr (mCellEquiv hT)]
    exact Γ.isSConf.euler hne
  S_mem := Γ.isSConf.S_mem

/-! ## The side function after the flip -/

/-- The side after the flip: the side of the corresponding old cell, except that the flipped
triangle changes side. -/
def mSide' : Orbit (Γ.σ * mα hT) → ZMod 2 := fun c =>
  Γ.side ((mCellEquiv hT).symm c) + if (mCellEquiv hT).symm c = Γ.cellOf t then 1 else 0

/-- The side value of the old dart `z`, plus one inside `T`. -/
def mF (Γ : SConf n D) (t z : D) : ZMod 2 :=
  Γ.mSide z + if Γ.cellOf z = Γ.cellOf t then 1 else 0

theorem mSide'_mk (y : D) : mSide' hT (Orbit.mk _ y) = Γ.mF t (mG' Γ t y) := rfl

theorem mF_of_ne {z : D} (h : Γ.cellOf z ≠ Γ.cellOf t) : Γ.mF t z = Γ.mSide z := by
  rw [mF, if_neg h, add_zero]

theorem mF_of_mem {z : D} (h : Γ.cellOf z = Γ.cellOf t) : Γ.mF t z = Γ.mSide z + 1 := by
  rw [mF, if_pos h]

/-- Away from the corners of `T` the side does not change. -/
theorem mSide'_of_not_corner {y : D} (hy : ¬ Γ.MCorner t y) :
    mSide' hT (Orbit.mk _ y) = Γ.mSide y := by
  rw [mSide'_mk, mG'_of_not_corner hy, mF_of_ne (m_not_mem_of_not_corner hy)]

/-- The flipped triangle `T'` (the cell of `σ² t`) changes side. -/
theorem mSide'_σσ : mSide' hT (Orbit.mk _ (Γ.σ (Γ.σ t))) = Γ.mSide t + 1 := by
  rw [mSide'_mk, mG'_σσ rfl, mF_of_mem rfl]

include hT in
/-- The side at the opposite dart `σ² (φ² b)` of the corner of `φ² b`. -/
theorem m_side_opp {b : D} (hb : Γ.cellOf b = Γ.cellOf t) :
    Γ.mSide (Γ.σ (Γ.σ (Γ.φ (Γ.φ b)))) + Γ.mSide b + 1 = Γ.mS b := by
  have hφb := m_tri_φ hb
  have hφφb := m_tri_φφ hb
  have h1 : Γ.mSide (Γ.φ (Γ.φ b)) = Γ.mSide b := by rw [mSide, mSide, hφφb, hb]
  have h2 : Γ.mS (Γ.σ (Γ.φ (Γ.φ b))) = Γ.mS (Γ.φ b) := by
    rw [m_tri_σ hT hφφb, m_tri_φφφ hT hφb, m_mS_straight]
  have h3 := m_tri_mS hT hb
  rw [m_side_σ, m_side_σ, h1, h2]
  have h4 : Γ.mS b = 1 + Γ.mS (Γ.φ b) + Γ.mS (Γ.φ (Γ.φ b)) := by
    rw [← h3]; generalize Γ.mS b = x; generalize Γ.mS (Γ.φ b) = y
    generalize Γ.mS (Γ.φ (Γ.φ b)) = z; revert x y z; decide
  rw [h4]
  generalize Γ.mSide b = x; generalize Γ.mS (Γ.φ b) = y
  generalize Γ.mS (Γ.φ (Γ.φ b)) = z; revert x y z; decide

theorem m_flip_isSide (y : D) :
    mSide' hT (Orbit.mk _ y) + mSide' hT (Orbit.mk _ (mα hT y)) = Γ.mS y := by
  rw [mSide'_mk, mSide'_mk]
  rcases m_dart_cases hT y with ⟨hy, hα⟩ | ⟨b, hb, h | h⟩ | ⟨b, hb, h | h | h | h⟩
  · have e : mα hT y = Γ.α y := by
      rw [mα_apply, mρ_of_not_corner hT hy, mρ_of_not_corner hT hα]
    rw [e, mG'_of_not_corner hy, mG'_of_not_corner hα, mF_of_ne (m_not_mem_of_not_corner hy),
      mF_of_ne (m_not_mem_of_not_corner hα)]
    exact Γ.m_isSide y
  all_goals subst y
  · rw [mα_end_straight hT hb, mG'_of_not_corner (m_not_corner_end_straight hT hb),
      mG'_of_mem hT hb, mF_of_ne (m_ne_end_straight hT hb), mF_of_ne (m_ne_straight hT hb),
      add_comm, Γ.m_isSide, m_mS_α]
  · rw [mα_end_σσ hT hb, mG'_of_not_corner (m_not_corner_end_σσ hT hb), mG'_α hT hb,
      mF_of_ne (m_ne_end_σσ hT hb), mF_of_ne (m_ne_σσ hT hb), add_comm, Γ.m_isSide, m_mS_α,
      m_mS_σσ]
  · rw [mα_of_mem hT hb, mG'_of_mem hT hb, mG'_of_not_corner (m_not_corner_end_straight hT hb),
      mF_of_ne (m_ne_straight hT hb), mF_of_ne (m_ne_end_straight hT hb), Γ.m_isSide,
      m_mS_straight]
  · rw [mα_α_of_mem hT hb, mG'_α hT hb, mG'_of_not_corner (m_not_corner_end_σσ hT hb),
      mF_of_ne (m_ne_σσ hT hb), mF_of_ne (m_ne_end_σσ hT hb), Γ.m_isSide, m_mS_σσ, m_mS_α]
  · rw [mα_straight_of_mem hT hb, mG'_straight hT hb, mG'_σσ hb,
      mF_of_ne (m_ne_σσ hT (m_tri_φφ hb)), mF_of_mem hb, ← add_assoc, m_side_opp hT hb,
      m_mS_straight]
  · rw [mα_σσ_of_mem hT hb, mG'_σσ hb, mG'_straight hT hb, mF_of_mem hb,
      mF_of_ne (m_ne_σσ hT (m_tri_φφ hb)), m_mS_σσ, ← m_side_opp hT hb]
    generalize Γ.mSide b = x; generalize Γ.mSide (Γ.σ (Γ.σ (Γ.φ (Γ.φ b)))) = y
    revert x y; decide

/-! ## The flip of the empty triangle above the finite edge of `d` -/

section Sweep

variable {d : D} (hd : Γ.EmptyTriAt d)
include hd

theorem m_side_upper : Γ.mSide (Γ.α d) = 1 := hd.1.1.2

theorem m_curve_d : Γ.curve d = Γ.S := hd.1.1.1

/-- The upper cell of `d` is a triangle with the side `α d` on `S`. -/
theorem m_mTri : Γ.MTri (Γ.α d) := ⟨hd.2, by rw [m_curve_α]; exact hd.1.1.1⟩

theorem m_side_d : Γ.mSide d = 0 := by
  have h := Γ.m_isSide d
  rw [m_side_upper hd, mS, if_pos (m_curve_d hd)] at h
  revert h; generalize Γ.mSide d = x; revert x; decide

/-- A sweep dart `a ≠ d` whose segment ends at a corner of the triangle ends at the corner `i`
and continues as `d` (`α a = straight (α d)`). -/
theorem m_sweep_corner {a : D} (ha : Γ.curve a = Γ.S) (hup : Γ.mSide (Γ.α a) = 1)
    (hne : a ≠ d) (hc : Γ.MCorner (Γ.α d) (Γ.α a)) : Γ.α a = Γ.straight (Γ.α d) := by
  have hT := m_mTri hd
  obtain ⟨b, hb, h⟩ := m_corner_cases hT hc
  have hcb : ∀ y, (y = b ∨ y = Γ.α b ∨ y = Γ.straight b ∨ y = Γ.σ (Γ.σ b)) →
      Γ.curve y = Γ.curve b := by
    rintro y (rfl | rfl | rfl | rfl)
    · rfl
    · exact Γ.m_curve_α b
    · exact Γ.m_curve_straight b
    · exact Γ.m_curve_σσ b
  have hbt : b = Γ.α d := by
    refine m_tri_injOn_curve hT rfl hb ?_
    rw [← hcb _ h, m_curve_α, ha, m_curve_α, m_curve_d hd]
  subst hbt
  rcases h with h | h | h | h
  · exact absurd (by rw [← Γ.m_α_α a, h, m_α_α]) hne
  · have : a = Γ.α d := by rw [← Γ.m_α_α a, h, m_α_α]
    rw [this, m_α_α, m_side_d hd] at hup
    exact absurd hup (by decide)
  · exact h
  · rw [h, m_side_σ, m_side_σ, m_side_upper hd, mS, if_pos hT.curve_t, mS,
      if_neg (fun h' => Γ.m_curve_σ _ (h'.trans hT.curve_t.symm))] at hup
    exact absurd hup (by decide)

/-- The side after the flip at the image of the reverse of an arc dart. -/
theorem m_flip_side_arc {a : D} (ha : a ∈ Γ.infArc) :
    mSide' (m_mTri hd) (Orbit.mk _ (mα (m_mTri hd) (mρ (m_mTri hd) a))) = 1 := by
  have hT := m_mTri hd
  obtain ⟨haS, hup⟩ := Γ.infArc_sweep a ha
  have hup' : Γ.mSide (Γ.α a) = 1 := hup
  have hne : a ≠ d := fun h => hd.1.2 (h ▸ ha)
  rw [mα_apply, mρ_mρ]
  by_cases hc : Γ.MCorner (Γ.α d) (Γ.α a)
  · have h := m_sweep_corner hd haS hup' hne hc
    rw [h, mρ_straight_of_mem hT rfl, mSide'_mk, mG'_of_mem hT rfl, mF_of_ne (m_ne_straight hT rfl),
      ← h, hup']
  · rw [mρ_of_not_corner hT hc, mSide'_of_not_corner hT hc, hup']

/-- The straight walk after the flip is `ρ straight ρ`. -/
theorem m_flip_straight_pow (z : D) (i : ℕ) :
    (straightPerm Γ.σ (mα (m_mTri hd)) ^ i) (mρ (m_mTri hd) z) =
      mρ (m_mTri hd) ((Γ.straight ^ i) z) := by
  induction i with
  | zero => rfl
  | succ i ih =>
    rw [pow_succ', Perm.mul_apply, ih, m_flip_straightPerm, mρ_mρ, pow_succ', Perm.mul_apply]

/-- The straight walk has the same period after the flip (at the `ρ`-image). -/
theorem m_flip_period (z : D) :
    period (straightPerm Γ.σ (mα (m_mTri hd))) (mρ (m_mTri hd) z) = period Γ.straight z := by
  have key : ∀ k, ((straightPerm Γ.σ (mα (m_mTri hd)))^[k]) (mρ (m_mTri hd) z) =
      mρ (m_mTri hd) z ↔ (Γ.straight^[k]) z = z := by
    intro k
    rw [← Perm.coe_pow, ← Perm.coe_pow, m_flip_straight_pow hd]
    exact (mρ (m_mTri hd)).injective.eq_iff
  unfold period
  apply le_antisymm
  · exact Nat.find_min' _ ⟨(Nat.find_spec (exists_iterate_eq Γ.straight z)).1,
      (key _).2 (Nat.find_spec (exists_iterate_eq Γ.straight z)).2⟩
  · exact Nat.find_min' _ ⟨(Nat.find_spec (exists_iterate_eq _ _)).1,
      (key _).1 (Nat.find_spec (exists_iterate_eq _ _)).2⟩

/-- The ∞-arc after the flip is the `ρ`-image of the old one. -/
theorem m_flip_arcOf :
    arcOf Γ.σ (mα (m_mTri hd)) (Γ.infStart.map (mρ (m_mTri hd))) Γ.infLen =
      Γ.infArc.image (mρ (m_mTri hd)) := by
  unfold infArc
  cases Γ.infStart with
  | none => rfl
  | some z =>
    simp only [Option.map_some, arcOf, Option.elim_some, image_image]
    congr 1
    funext i
    exact m_flip_straight_pow hd z i

/-- **The flipped sweep configuration** (passing the empty triangle above the finite edge of
`d`): same darts, `σ`, labels and `S`; `α' = ρ α ρ`; the side of the old cell except for the
flipped triangle; the ∞-arc mapped by `ρ` (start `ρ z`, same length). -/
def mFlip : SConf n D where
  σ := Γ.σ
  α := mα (m_mTri hd)
  curve := Γ.curve
  S := Γ.S
  isSConf := m_flip_isSConf (m_mTri hd)
  side := mSide' (m_mTri hd)
  isSide y := m_flip_isSide (m_mTri hd) y
  infStart := Γ.infStart.map (mρ (m_mTri hd))
  infLen := Γ.infLen
  infStart_isSome hne := by rw [Option.isSome_map]; exact Γ.infStart_isSome hne
  infLen_le z' hz' := by
    obtain ⟨z, hz, rfl⟩ := Option.mem_map.1 hz'
    rw [m_flip_period hd z]
    exact Γ.infLen_le z hz
  infArc_sweep := by
    intro a' ha'
    rw [m_flip_arcOf hd] at ha'
    obtain ⟨a, ha, rfl⟩ := mem_image.1 ha'
    refine ⟨by rw [m_curve_ρ]; exact (Γ.infArc_sweep a ha).1, ?_⟩
    exact m_flip_side_arc hd ha

end Sweep

end SConf

end Pca.Sweep

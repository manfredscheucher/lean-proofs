/-- `side j k s m`: the entry of `sideList`, `0` if there is none. -/
def side (j k : ℕ) (s : ℤ) (m : ℕ) : ℤ :=
  match sideList.find? (fun e => e.1 == j && e.2.1 == k && e.2.2.1 == s && e.2.2.2.1 == m) with
  | some e => e.2.2.2.2
  | none => 0

/-- Sanity check of the table: every entry is a valid crossing `1 ≤ j < k ≤ 6`, `s = ±1`, a
circle `m ∉ {j, k}`, and a sign `±1`; and there are `6·5·4` entries, one per
crossing point and circle not through it (no duplicates). -/
theorem sideList_valid :
    (∀ e ∈ sideList, 1 ≤ e.1 ∧ e.1 < e.2.1 ∧ e.2.1 ≤ 6 ∧ (e.2.2.1 = 1 ∨ e.2.2.1 = -1) ∧
      1 ≤ e.2.2.2.1 ∧ e.2.2.2.1 ≤ 6 ∧ e.2.2.2.1 ≠ e.1 ∧ e.2.2.2.1 ≠ e.2.1 ∧
      (e.2.2.2.2 = 1 ∨ e.2.2.2.2 = -1)) ∧
    (sideList.map fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)).Nodup ∧
    sideList.length = 120 := by
  decide +kernel

section

